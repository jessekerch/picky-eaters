<h2>All Ingredients, sorted by name:</h2>
Click on an ingredient to see recipes which include it.

<section class="all_list">
  <% if @ingredients.empty? %>
    <p class="empty_list">You don't have any ingredients yet. Add a new ingredient!</p>
  <% else %>
    <ul>
      <% @ingredients.each do |ingredient| %>
        <li>
          <a href="/ingredients/<%= ingredient[:id] %>">
            <%= ingredient[:name] %>
          </a>
       </li>
      <% end %>
    </ul>
  <% end %>
</section>

<% if @total_page_count > 1 %>
  <div class="pagination">
    <a href="/ingredients?page=<%= @prev_page %>">&laquo;</a>
    <% 1.upto(@total_page_count) do |page| %>
      <a href="/ingredients?page=<%= page %>" class="<%= active_class(@current_page, page) %>">
        <%= page %>
      </a>
    <% end %>
    <a href="/ingredients?page=<%= @next_page %>">&raquo;</a>
  </div>
<% end %>

<% content_for :action_links do %>
  <div>
    <a href="/recipes/new">+NEW RECIPE</a>
  </div>
  <div>
    <a href="/ingredients/new">+NEW INGREDIENT</a>
  </div>
  <div>
    <a href="/family_members/new">+NEW FAMILY MEMBER</a>
  </div>
<% end %>
