<h2>All Recipes, sorted by name:</h2>
Click on a recipe to see likes, ingredients, directions, and notes.

<section class="all_list">
  <% if @recipes.empty? %>
    <p class="empty_list">You don't have any recipes yet. Add a new recipe!</p>
  <% else %>
    <ul>
      <% @recipes.each do |recipe| %>
        <li>
          <a href="/recipes/<%= recipe[:recipe_id] %>">
            <%= recipe[:name] %>
          </a>
       </li>
      <% end %>
    </ul>
  <% end %>
</section>

<% if @total_page_count > 1 %>
  <div class="pagination">
    <a href="/recipes?page=<%= @prev_page %>">&laquo;</a>
    <% 1.upto(@total_page_count) do |page| %>
      <a href="/recipes?page=<%= page %>" class="<%= active_class(@current_page, page) %>">
        <%= page %>
      </a>
    <% end %>
    <a href="/recipes?page=<%= @next_page %>">&raquo;</a>
  </div>
<% end %>

<% content_for :action_links do %>
  <div>
    <a href="/recipes/new">+NEW RECIPE</a>
  </div>
  <div>
    <a href="/ingredients/new">+NEW INGREDIENT</a>
  </div>
  <div>
    <a href="/family_members/new">+NEW FAMILY MEMBER</a>
  </div>
<% end %>
