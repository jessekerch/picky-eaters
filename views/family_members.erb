<h2>All Family Members, sorted by name:</h2>
Click on a family member to see their favorite recipes.

<section class="all_list">
  <% if @family_members.empty? %>
    <p class="empty_list">Your family doesn't have any members yet. Add a new family member!</p>
  <% else %>
    <ul>
      <% @family_members.each do |family_member| %>
        <li>
          <a href="/family_members/<%= family_member[:id] %>" class="">
            <%= family_member[:name] %>
          </a>
       </li>
      <% end %>
    </ul>
  <% end %>
</section>

<% if @total_page_count > 1 %>
  <div class="pagination">
    <a href="/family_members?page=<%= @prev_page %>">&laquo;</a>
    <% 1.upto(@total_page_count) do |page| %>
      <a href="/family_members?page=<%= page %>" class="<%= active_class(@current_page, page) %>">
        <%= page %>
      </a>
    <% end %>
    <a href="/family_members?page=<%= @next_page %>">&raquo;</a>
  </div>
<% end %>

<% content_for :action_links do %>
  <div>
    <a href="/recipes/new">+NEW RECIPE</a>
  </div>
  <div>
    <a href="/ingredients/new">+NEW INGREDIENT</a>
  </div>
  <div>
    <a href="/family_members/new">+NEW FAMILY MEMBER</a>
  </div>
<% end %>
